# decisaur configuration.
#
# This file is committed. Your `.env` is not - `.gitignore` excludes it, so the values
# you tune never end up in a commit.
#
#   cp .env.example .env
#
# Every key below is required. There are no fallback values in the source: `npm run
# build` and the Node CLIs read this file and refuse to run with a missing or invalid
# key, rather than inventing one. A silent default is a value you cannot reason about
# when something misbehaves.
#
# Your shell environment wins over this file. `process.loadEnvFile` does not overwrite
# variables that are already set, so `DECISAUR_MODEL=tev1:2b npm run sim` works for a
# one-off experiment without editing anything.
#
# The browser bundles carry their own copy of these values, inlined by
# `scripts/build.mjs` at build time - a script pasted into the DevTools console cannot
# read a file from disk. Editing this file therefore only affects the browser after
# `npm run build` is re-run.


# Base URL of the Ollama server.
#
# Needs the scheme: `http://127.0.0.1:11434`, not `127.0.0.1:11434`.
#
# Note this is NOT the same variable as `OLLAMA_HOST`, which `npm run proxy` reads as a
# bare hostname with no scheme and no port. Keep them separate.
#
# From `chrome://dino` the direct port is refused by Chrome regardless of this value,
# so point the browser at the proxy instead (default port 11436):
#
#   decisaurHost = 'http://127.0.0.1:11436';
DECISAUR_HOST=http://127.0.0.1:11434

# The System One decision model: `tev1` served by Ollama's POST /v1/systemone
# endpoint, answering `choice` / `noul` / `score` questions with probability
# distributions in a single forward pass.
#
# Must already be pulled: `ollama pull tev1:0.8b`.
DECISAUR_MODEL=tev1:0.8b

# How long Ollama keeps the model resident in memory. Cold start costs ~300ms before
# the first answer, which is a large slice of the ~260ms round trip the perception
# budget is sized around.
#
# A duration with an s/m/h suffix, or 0 to let Ollama unload the model when idle.
DECISAUR_KEEP_ALIVE=10m

# How far ahead, in game pixels, an obstacle enters the model's field of view.
#
# At the game's top speed of 13px/frame @60fps that is 780px/s, so 460px buys ~590ms
# of warning - enough for the ~260ms round trip plus slack. This is the number to raise
# if you move to a slower model or a faster machine's worth of headroom is not
# available; lower it and the answer arrives after the obstacle is already committed.
DECISAUR_PERCEPTION_RANGE=460

# Hard cap on concurrent model queries. The server serialises small models anyway, and
# the loop is only paced for one query in flight, so raising this buys a queue rather
# than throughput.
DECISAUR_MAX_CONCURRENT=1

# Where in the clearance window to line an obstacle up.
#
# A jump lasts ~34 frames, and at top speed consecutive obstacles can be only 22-34
# frames apart (`getGap` gives 293-440px at 13px/frame), so the dino is sometimes
# still airborne when the next obstacle arrives.
#
# 0.54 sits just past the middle of the window, which is where the dino is highest for
# the longest time - so a slightly late jump still clears. Measured by sweeping the
# value across seeds (`node src/node/sweep-aim.js`); survival of a 20000-frame run:
#
#   aim  0.40  0.46  0.50  0.54  0.58  0.60  0.70  0.90
#   ok   8/20  14/20 15/20  19/24  13/24  9/20   0/12  0/12
#
# The curve is sharply peaked and aiming late is fatal, because the obstacle then
# arrives exactly as the dino descends back through the clearance height. 0.54 holds up
# on held-out seeds (19/30 at 30000 frames).
#
# If you change this, re-run the sweep. It is the one value here with no safe
# "close enough", and it also applies to model-chosen jumps via the reflex layer.
DECISAUR_JUMP_AIM=0.54